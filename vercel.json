{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.arcanetecnologia.com.br" }],
      "destination": "https://arcanetecnologia.com.br/$1",
      "permanent": true
    },
    { "source": "/solicitar-orcamento", "destination": "/contact", "permanent": true },
    { "source": "/services/sites-premium", "destination": "/services/arcane-digital", "permanent": true },
    { "source": "/services/arcane-labs", "destination": "/services/arcane-rise", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/services/arcane-digital", "destination": "/services/arcane-digital/index.html" },
    { "source": "/services/arcane-growth", "destination": "/services/arcane-growth/index.html" },
    { "source": "/services/arcane-rise", "destination": "/services/arcane-rise/index.html" },
    { "source": "/projects", "destination": "/projects/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/a-atencao-certa-comeca-antes-do-clique", "destination": "/blog/a-atencao-certa-comeca-antes-do-clique/index.html" },
    { "source": "/blog/quando-uma-ideia-pede-um-produto-proprio", "destination": "/blog/quando-uma-ideia-pede-um-produto-proprio/index.html" },
    { "source": "/blog/automacao-boa-devolve-tempo-para-o-negocio", "destination": "/blog/automacao-boa-devolve-tempo-para-o-negocio/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/terms", "destination": "/terms/index.html" },
    { "source": "/cookies", "destination": "/cookies/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
